#!/usr/bin/env bash
# 5code — shaxsiy lokal AGENTIC kod yordamchisi (Claude Code uslubida)
#
# Joriy ishlab turgan papka ustida ishlaydi: fayl o'qiydi/yozadi, shell
# buyruq bajaradi (xavfli buyruqlarga terminalda tasdiq so'raydi).
#
#   5code                 interaktiv suhbat (shu papka ustida)
#   5code "savol"         bir martalik savol / topshiriq
#   cat main.py | 5code "shu kodni tushuntir"
#   5code --provider gemini "savol"   boshqa provider bilan
#   5code --web           web interfeysni ochish
#   5code --update        modelni Modelfile'dan qayta yig'ish
#   5code --status        holat tekshiruvi

set -euo pipefail

MODEL="5code"
PROJECT_DIR="__PROJECT_DIR__"
BACKEND_PORT=1221
FRONTEND_PORT=1991

c_dim=$'\033[2m'; c_acc=$'\033[36m'; c_err=$'\033[31m'; c_off=$'\033[0m'

die() { printf '%s%s%s\n' "$c_err" "$1" "$c_off" >&2; exit 1; }

command -v ollama >/dev/null 2>&1 || die "Ollama o'rnatilmagan: https://ollama.com/download"

# Ollama serveri yopiq bo'lsa — fonda ko'taramiz
ensure_server() {
  if ! curl -fsS http://localhost:11434/api/version >/dev/null 2>&1; then
    printf '%sOllama ishga tushirilmoqda…%s\n' "$c_dim" "$c_off" >&2
    nohup ollama serve >/tmp/ollama.log 2>&1 &
    for _ in $(seq 1 30); do
      curl -fsS http://localhost:11434/api/version >/dev/null 2>&1 && return 0
      sleep 0.5
    done
    die "Ollama serveri javob bermadi. /tmp/ollama.log ni tekshiring."
  fi
}

ensure_model() {
  if ! ollama list 2>/dev/null | awk '{print $1}' | grep -qE "^${MODEL}(:latest)?$"; then
    printf '%s'\''%s'\'' modeli topilmadi — yaratilmoqda…%s\n' "$c_dim" "$MODEL" "$c_off" >&2
    [ -f "$PROJECT_DIR/ollama/Modelfile" ] \
      || die "Modelfile topilmadi: $PROJECT_DIR/ollama/Modelfile"
    ollama create "$MODEL" -f "$PROJECT_DIR/ollama/Modelfile"
  fi
}

case "${1:-}" in
  --web|-w)
    ensure_server
    url="http://localhost:$FRONTEND_PORT"
    if ! curl -fsS "http://localhost:$BACKEND_PORT/api/health" >/dev/null 2>&1; then
      printf '%sBackend ishlamayapti. Ishga tushirish: cd %s && ./run.sh%s\n' \
        "$c_dim" "$PROJECT_DIR" "$c_off" >&2
    fi
    printf 'Ochilmoqda: %s%s%s\n' "$c_acc" "$url" "$c_off"
    open "$url" 2>/dev/null || xdg-open "$url" 2>/dev/null || true
    exit 0
    ;;
  --update|-u)
    ensure_server
    [ -f "$PROJECT_DIR/ollama/Modelfile" ] \
      || die "Modelfile topilmadi: $PROJECT_DIR/ollama/Modelfile"
    ollama create "$MODEL" -f "$PROJECT_DIR/ollama/Modelfile"
    printf '%s✓ %s yangilandi%s\n' "$c_acc" "$MODEL" "$c_off"
    exit 0
    ;;
  --status|-s)
    ensure_server
    printf 'Ollama:  %s\n' "$(ollama --version 2>&1 | head -1)"
    printf 'Modellar:\n'; ollama list
    if curl -fsS "http://localhost:$BACKEND_PORT/api/health" >/dev/null 2>&1; then
      printf 'Backend: %s✓ ishlayapti%s (port %s)\n' "$c_acc" "$c_off" "$BACKEND_PORT"
    else
      printf 'Backend: o'\''chiq (port %s)\n' "$BACKEND_PORT"
    fi
    exit 0
    ;;
  --help|-h)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

ensure_server
ensure_model

# Agentic CLI (app.cli) — fayl o'qish/yozish va shell uchun Python muhiti kerak.
PYTHON="$PROJECT_DIR/.venv/bin/python"
if [ ! -x "$PYTHON" ]; then
  printf '%sPython muhiti birinchi marta sozlanmoqda…%s\n' "$c_dim" "$c_off" >&2
  python3 -m venv "$PROJECT_DIR/.venv"
  "$PROJECT_DIR/.venv/bin/pip" install -q --upgrade pip
  "$PROJECT_DIR/.venv/bin/pip" install -q -r "$PROJECT_DIR/requirements.txt"
fi

# PYTHONPATH orqali `app` paketini topadi — cwd o'zgarmaydi, chunki 5code
# JORIY ishlab turgan papka ustida ishlashi kerak (Claude Code kabi).
exec env PYTHONPATH="$PROJECT_DIR" "$PYTHON" -m app.cli "$@"
