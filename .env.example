# ============================================================
#  AI PROVIDER — qaysi xizmat ishlatilsin
#  gemini    → TEKIN, eng kuchli bepul variant (tavsiya)
#  openai    → OpenAI-mos: Groq / OpenRouter / Ollama
#  anthropic → Claude (pullik, eng kuchli)
# ============================================================
AI_PROVIDER=gemini

# --- Gemini (TEKIN) ---
# Kalit oling: https://aistudio.google.com/apikey  (kredit karta kerak emas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- OpenAI-mos xizmatlar (AI_PROVIDER=openai bo'lganda) ---
# Groq (tekin, juda tez):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
#   kalit: https://console.groq.com/keys
# OpenRouter (tekin modellar :free suffiks bilan):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=deepseek/deepseek-chat:free
#   kalit: https://openrouter.ai/keys
# Ollama (butunlay lokal, kalit kerak emas):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=qwen2.5-coder
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# --- Claude (ixtiyoriy, pullik) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=32000

# ============================================================
#  Portlar
# ============================================================
BACKEND_PORT=1221
FRONTEND_PORT=1991
# React dev-serveri uchun CORS (JSON ro'yxat)
# CORS_ORIGINS=["http://localhost:1991","http://127.0.0.1:1991"]

# Ochiq ro'yxatdan o'tish (false bo'lsa — faqat admin user yaratadi)
ALLOW_SIGNUP=true

# ============================================================
#  Lokal model (Ollama)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=5code

# ============================================================
#  Xavfsizlik
# ============================================================
# Yangi kalit: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Birinchi admin (birinchi ishga tushishda yaratiladi)
ADMIN_USERNAME=macbookair_4
# Bo'sh qoldirsangiz — server tasodifiy parol yaratadi va logga bir marta chiqaradi.
ADMIN_PASSWORD=

# ai_in_pc sandbox — fayl/shell amallari faqat shu papkada
WORKSPACE_ROOT=./workspace
SHELL_TIMEOUT_SECONDS=60

DEBUG=false
